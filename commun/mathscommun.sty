\tcbset{pedago/.style={enhanced,breakable=false,colback=white,colframe=accent!70,boxrule=.45pt,arc=1mm,left=3mm,right=3mm,top=1.7mm,bottom=1.7mm,before skip=6pt,after skip=6pt,fonttitle=\sffamily\bfseries,coltitle=black,colbacktitle=grisclair}}
